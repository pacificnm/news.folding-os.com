# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://news:CHANGEME@192.168.88.10:5432/news

# SSO — client_secret comes from:
#   docker compose exec identity-backend python scripts/manage.py create-client \
#     --client-id news --name news.folding-os.com \
#     --redirect-uri https://news.folding-os.com/auth/callback \
#     --redirect-uri http://192.168.88.10:3006/auth/callback   (LAN testing)
IDENTITY_ISSUER=https://identity.folding-os.com
IDENTITY_CLIENT_ID=news
IDENTITY_CLIENT_SECRET=CHANGEME

# AI (local Ollama — no third-party API key needed)
OLLAMA_BASE_URL=http://192.168.88.10:11434
OLLAMA_MODEL=qwen3.5:2b

AI_RATE_LIMIT_PER_MINUTE=30
FEED_CACHE_TTL_SECONDS=60
